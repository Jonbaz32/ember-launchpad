# Point at the deployed TokenFactory (see contracts/script/Deploy.s.sol)
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Set true while developing against Robinhood Chain Testnet (chain id 46630)
VITE_USE_TESTNET=true

# Optional: override public RPCs with your own provider endpoint (Alchemy, QuickNode, etc.)
# VITE_RH_MAINNET_RPC=https://robinhood-mainnet.g.alchemy.com/v2/<key>
# VITE_RH_TESTNET_RPC=https://robinhood-testnet.g.alchemy.com/v2/<key>

# Optional: base URL of the indexer service (see ../indexer)
VITE_INDEXER_URL=http://localhost:8787
